<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>io.github.darshanrathod04</groupId>
	<artifactId>shree-ai-os</artifactId>
	<version>1.0.3-developer-preview</version>
	<name>Shree AI OS</name>
	<description>In-process, privacy-first cognitive runtime and hybrid RAG engine for Java 21</description>
	<url>https://github.com/darshanrathod04/shree-ai-os</url>
	<licenses>
		<license>
			<name>Shree AI OS Proprietary Evaluation License v1.0</name>
			<url>https://github.com/darshanrathod04/shree-ai-os/blob/main/LICENSE</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>darshanrathod04</id>
			<name>Darshan Rathod</name>
			<email>darshanrathod04@users.noreply.github.com</email>
			<url>https://github.com/darshanrathod04</url>
			<organization>Darshan Rathod</organization>
			<organizationUrl>https://github.com/darshanrathod04</organizationUrl>
			<roles>
				<role>developer</role>
			</roles>
			<timezone>Asia/Kolkata</timezone>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/darshanrathod04/shree-ai-os.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/darshanrathod04/shree-ai-os.git</developerConnection>
		<url>https://github.com/darshanrathod04/shree-ai-os</url>
		<tag>HEAD</tag>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
    <dependencies>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Jackson (JSON handling) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Jackson JSR310 (Java 8 date/time support) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- OkHttp (HTTP client for LLM calls) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- Lombok (optional but useful) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						EO-V1-REL1-BUGFIX-002: Legacy test classification.
						These three test classes verify the preserved research/prototype
						system (legacy brain/autonomy/chief/planner/personality packages).
						They are excluded from the V1 release test execution scope using
						an explicit, narrow class-level exclusion. The tests are preserved
						in the repository and can be run explicitly via:
						  mvn -Dtest=AutonomousPlanningTests,ConversationContinuityTests,ExecutionAuditTests test
						See docs/engineering/EO-V1-REL1-BUGFIX-002-TEST-OWNERSHIP.md
					-->
					<excludes>
						<exclude>com/shreeai/os/platform/AutonomousPlanningTests.java</exclude>
						<exclude>com/shreeai/os/platform/ConversationContinuityTests.java</exclude>
						<exclude>com/shreeai/os/platform/ExecutionAuditTests.java</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
					<!--
						EO-V1-REL1-SDK-PKG-001:
						Produce the executable Spring Boot JAR with an '-exec' classifier
						so the main artifact (shree-ai-os-1.0.0-developer-preview.jar) remains the
						plain Maven-consumable JAR with classes at the root.
					-->
					<classifier>exec</classifier>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Maven Central Publishing Plugins -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>verify</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<phase>verify</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-gpg-plugin</artifactId>
				<version>3.2.8</version>
				<executions>
					<execution>
						<id>sign-artifacts</id>
						<phase>verify</phase>
						<goals>
							<goal>sign</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- Maven Central Publishing Configuration -->
	<distributionManagement>
		<snapshotRepository>
			<id>sonatype-nexus-snapshots</id>
			<url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
		</snapshotRepository>
		<repository>
			<id>sonatype-nexus-staging</id>
			<url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
		</repository>
	</distributionManagement>

</project>
