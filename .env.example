# =============================================================================
# Shree AI OS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables are read by the Spring Boot application and by the
# VectorStoreProviders configuration layer. Spring Boot's relaxed binding
# maps SHREE_VECTOR_* env vars directly to shree.vector.* properties, so
# you can set these in .env (via docker-compose), in your shell, or in
# IDE run configurations.
#
# For docker-compose: these values are also used by docker-compose.yml
# for the postgres service (POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD).
# =============================================================================

# --- PostgreSQL + pgvector ---
POSTGRES_DB=shree
POSTGRES_USER=postgres
POSTGRES_PASSWORD=shreeai

# --- Vector store configuration (Spring Boot shree.vector.* properties) ---
# Provider: "pgvector" (default: "in-memory" — no DB required)
SHREE_VECTOR_PROVIDER=pgvector
# JDBC connection string for pgvector
SHREE_VECTOR_JDBC_URL=jdbc:postgresql://localhost:5432/shree
SHREE_VECTOR_JDBC_USER=postgres
SHREE_VECTOR_JDBC_PASSWORD=shreeai

# Embedding dimensionality — must match your embedder
# LocalDeterministicEmbedder default = 384
SHREE_EMBEDDING_DIMENSIONS=384

# --- LLM / AI Provider ---
# Set to "onnx" to use the local ONNX embedder (no API key needed).
# Set to "gemini" to use Google Gemini (requires GEMINI_API_KEY).
SHREE_EMBEDDING_PROVIDER=onnx

# Google Gemini API key (only needed when SHREE_EMBEDDING_PROVIDER=gemini)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
